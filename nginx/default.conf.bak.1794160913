server {
    listen 80;
    server_name parlamentmlodych.pl www.parlamentmlodych.pl;
    client_max_body_size 50M;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    
    location / {
        return 403;
    }

    error_page 403 /maintenance.html;
    location = /maintenance.html {
        root /var/www/nginx;
        internal;
    }
}

server {
    listen 443 ssl;
    server_name parlamentmlodych.pl www.parlamentmlodych.pl;
    client_max_body_size 50M;
    ssl_certificate /etc/letsencrypt/live/parlamentmlodych.pl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/parlamentmlodych.pl/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # ═══════════════ NOWY SYSTEM (PRZED location /) ═══════════════
    location /uploads/ {
        alias /var/www/uploads/;
        try_files $uri =404;
    }

    location /newapp/api/ {
        rewrite ^/newapp/api/(.*)$ /api/$1 break;
        proxy_pass http://mparlament-backend-ts:4001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    location /newapp/socket.io/ {
        proxy_pass http://mparlament-backend-ts:4001/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
                proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 86400;
    }

    location /socket.io/ {
        proxy_pass http://mparlament-backend-ts:4001/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }


    # ═══════════════ STARY SYSTEM ═══════════════

    location / {
        # SPA nowego systemu: PY serwuje statyki pod /newapp/, ale nie ma SPA fallback.
        # Proxy → /newapp/<ścieżka>; jeśli PY zwróci 404 → @spa_fallback (index.html).
        rewrite ^/(.*)$ /newapp/$1 break;
        proxy_pass http://new-backend:4000;
        proxy_intercept_errors on;
        error_page 404 = @spa_fallback;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    location /api/ {
        proxy_pass http://mparlament-backend-ts:4001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # stary /api/ → backend:8000 (już nieużywany, ale zostawiamy na rollback)
}